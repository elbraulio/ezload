<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.elbraulio</groupId>
    <artifactId>ezload</artifactId>
    <version>SNAPSHOT</version>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
    </properties>
    <packaging>jar</packaging>
    <description>load data from formatted files to a relational data base</description>
    <url>https://github.com/elbraulio/ezload</url>
    <licenses>
        <license>
            <name>MIT</name>
            <url>https://github.com/elbraulio/ezload/blob/master/LICENSE</url>
            <distribution>site</distribution>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:git@github.com:elbraulio/ezload.git</connection>
        <developerConnection>
            scm:git:git@github.com:elbraulio/ezload.git
        </developerConnection>
        <url>https://github.com/elbraulio/ezload</url>
    </scm>
    <developers>
        <developer>
            <id>1</id>
            <name>Braulio Lopez</name>
            <email>brauliop.3@gmail.com</email>
            <organization>elbraulio.com</organization>
            <organizationUrl>http://www.elbraulio.com</organizationUrl>
            <roles>
                <role>Architect</role>
                <role>Developer</role>
            </roles>
            <timezone>-4</timezone>
        </developer>
    </developers>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <!-- Ensure you include existing argLine if you have one, or keep it empty -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>26</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <!-- unit testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Mokito for test -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
